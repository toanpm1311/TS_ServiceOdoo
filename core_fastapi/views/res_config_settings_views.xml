<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_core_fastapi" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.core.fastapi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="API Settings" string="API Settings" name="core_fastapi"
                    groups="base.group_no_one"
                    logo="/core_fastapi/static/description/icon.png">
                    <block title="Development" name="core_fastapi_development">
                        <setting string="Api Debug" id="mobile_setting_debug"
                            help="Enable Debug Mode for FastAPI">
                            <field name="api_debug" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
