<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <!-- Daily -->
        <record forcecreate="True" id="ir_cron_sync_zalo_feedback" model="ir.cron">
            <field name="name">Zalo: Sync Feedback</field>
            <field name="model_id" ref="model_ticket_rating"/>
            <field name="state">code</field>
            <field name="code">model.sync_zalo_data_for_period()</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="save_log" eval="True"/>
            <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 17:00:00')"/>
        </record>
    </data>
</odoo>
