<odoo>
  <data>
    <!-- Wizard Form View -->
    <record id="view_ticket_research_time_wizard_form" model="ir.ui.view">
        <field name="name">Ticket Research Time Wizard Form</field>
        <field name="model">ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Repair Warranty Data Report">
                <div class="oe_button_box" name="button_box">
                    <button string="Load Tickets" 
                            type="object" 
                            name="action_load_lines" 
                            class="btn-primary" 
                            icon="fa-search"/>

                    <button string="Export to XLSX"
                            type="object"
                            name="action_export_xlsx"
                            class="btn-success"
                            target="new"
                            icon="fa-file-excel-o"
                            />
                </div>

                <div class="row mb-4">
                    <div class="col-12 text-center">
                    <h1>Ticket Report</h1>
                    <p class="o_form_subtitle">Total Ticket HelpDesk by employee</p>
                    </div>
                </div>
                <div class="custom_filter_and_table">
                    <!-- Cục bên trái -->
                    <div class="custom_filter">
                        <group string="Bộ lọc">
                            <field name="customer_name"/>
                            <field name="customer_name"/>
                            <field name="customer_name"/>
                            <field name="customer_name"/>
                            <field name="customer_name"/>
                        </group>
                    </div>

                    <!-- Cục bên phải -->
                    <div class="custom_table">
                        <group class="centered_group" string="Danh sách yêu cầu">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="stt"/>
                                    <field name="customer_contact_name"/>
                                    <field name="subject"/>
                                    <field name="description"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </group>
                    </div>
                </div>
            </form>
        </field>
    </record>


    <!-- Wizard Action -->
    <record id="action_ticket_research_time_wizard" model="ir.actions.act_window">
      <field name="name">Ticket Report</field>
      <field name="res_model">ticket.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_ticket_research_time_wizard_form"/>
      <field name="target">current</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_ticket_research_time_report"
              name="Ticket HelpDesk Report"
              parent="menu_helpdesk_reports"
              action="action_ticket_research_time_wizard"/>
  </data>
</odoo>
