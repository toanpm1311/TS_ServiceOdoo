<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard form with embedded tree -->
        <record id="view_step_provide_tech_wizard_form" model="ir.ui.view">
            <field name="name">step.provide.tech.wizard.form</field>
            <field name="model">step.provide.tech.wizard</field>
            <field name="arch" type="xml">
                <form string="Provide Tech Solutions Step Report" create="false" delete="false" edit="false">
                    <div class="oe_button_box" name="button_box">
                        <button string="Export to XLSX"
                                type="object"
                                name="action_export_xlsx"
                                class="btn-success"
                                target="new"
                                icon="fa-file-excel-o"/>
                    </div>
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <h1>Provide Tech Solutions Step Report</h1>
                            <p class="o_form_subtitle">Number of Provide Tech Solutions tasks by employee</p>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="employee_id" string="Employee" options="{'no_create': True}"/>
                            <field name="department_name" string="Department" options="{'no_create': True}"/>
                            <field name="company_id" string="Company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1" widget="one2many_list">
                        <tree string="Report" editable="false">
                            <field name="sequence" string="STT"/>
                            <field name="create_date"/>
                            <field name="employee_id"/>
                            <field name="department_name"/>
                            <field name="company_id"/>
                            <field name="step_count"/>
                        </tree>
                    </field>
                </form>
            </field>
        </record>

        <!-- Action to open the wizard -->
        <record id="action_step_provide_tech_wizard" model="ir.actions.act_window">
            <field name="name">Provide Tech Solutions Step Report</field>
            <field name="res_model">step.provide.tech.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_step_provide_tech_wizard_form"/>
            <field name="target">current</field>
        </record>

        <!-- Menu entry under your Customer Service reports -->
        <menuitem id="menu_step_provide_tech_report"
                  name="Provide Tech Solutions Report"
                  parent="menu_helpdesk_reports"
                  action="action_step_provide_tech_wizard"/>

        # Inherit view_step_provide_tech_wizard_form to add Reset button after the action_export_xlsx button
        <record id="view_step_provide_tech_wizard_form_inherit" model="ir.ui.view">
            <field name="name">step.provide.tech.wizard.form.inherit</field>
            <field name="model">step.provide.tech.wizard</field>
            <field name="inherit_id" ref="view_step_provide_tech_wizard_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_export_xlsx']" position="after">
                    <button name="%(dat_dashboard.action_step_provide_tech_wizard)d"
                            type="action"
                            string="Reset"
                            class="btn-light"
                            icon="fa-refresh"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
