<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form with embedded tree -->
        <record id="view_repair_warranty_analysis_form" model="ir.ui.view">
            <field name="name">repair.warranty.report.wizard.form</field>
            <field name="model">repair.warranty.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Repair Warranty Data Report" create="false" delete="false" edit="false">
                    <div class="oe_button_box" name="button_box">
                        <button string="Export to XLSX"
                                type="object"
                                name="action_export_xlsx"
                                class="btn-success"
                                target="new"
                                icon="fa-file-excel-o"/>
                    </div>
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <h1>Repair Warranty Data Report</h1>
                            <p class="o_form_subtitle">Detail of warranty and repair requests by customer</p>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="request_code"/>
                        </group>
                        <group>
                            <field name="customer_id" options="{'no_create': True}"/>
                            <field name="engineer_id" options="{'no_create': True}"/>
                            <field name="branch_id" options="{'no_create': True}"/>
                            <field name="business_unit" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1" widget="one2many_list">
                        <tree string="Data Details" editable="false">
                            <field name="sequence" string="STT"/>
                            <field name="ticket_id"/>                        <!-- Request Code -->
                            <field name="customer_id"/>                 <!-- Customer -->
                            <field name="saleperson_id"/>               <!-- Salesperson -->
                            <field name="sap_business_unit"/>           <!-- Business Unit -->
                            <field name="product_id"/>                  <!-- Item Code -->
                            <field name="stock_lot_id"/>                <!-- Serial Number -->
                            <field name="create_date"/>                 <!-- Create Date -->
                            <field name="status" widget="badge"
                                   decoration-primary="status == 'new'"
                                   decoration-info="status == 'in_progress'"
                                   decoration-success="status == 'closed'"
                                   decoration-danger="status == 'rejected'"
                                   decoration-warning="status == 'on_hold'"
                            />                      <!-- Request Status -->
                            <field name="priority_id"/>                 <!-- Priority -->
                            <field name="ticket_type_id"/>              <!-- Request Type -->
                            <field name="step_id"/>                     <!-- Current Step -->
                            <field name="assigned_user_id"/>
                            <field name="product_warranty_status"/>     <!-- Warranty Status -->
                            <field name="status_after_repair"/>         <!-- Status After Repair -->
                            <field name="is_warranty_remote"/>
                            <field name="warranty_service_type"/>       <!-- Service Action -->
                            <field name="branch"/>                      <!-- Branch -->
                            <field name="total_time_spent" widget="timesheet_uom"/>            <!-- Time To Finish -->
                            <field name="service_action"/>              <!-- Resolution -->
                            <field name="request_return_reason"/>       <!-- Reason Return -->
                        </tree>
                    </field>
                </form>
            </field>
        </record>

        <!-- Action to open the wizard -->
        <record id="action_repair_warranty_analysis" model="ir.actions.act_window">
            <field name="name">Repair Warranty Data Report</field>
            <field name="res_model">repair.warranty.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_repair_warranty_analysis_form"/>
            <field name="target">current</field>
        </record>

        <!-- Menu entry under Customer Service reports -->
        <menuitem id="menu_repair_warranty_report"
                  name="Warranty Repair Report"
                  parent="menu_helpdesk_reports"
                  action="action_repair_warranty_analysis"/>

        # Inherit view_repair_warranty_analysis_form to add Reset button after the action_export_xlsx button
        <record id="view_repair_warranty_analysis_form_inherit" model="ir.ui.view">
            <field name="name">repair.warranty.analysis.form.inherit</field>
            <field name="model">repair.warranty.report.wizard</field>
            <field name="inherit_id" ref="view_repair_warranty_analysis_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_export_xlsx']" position="after">
                    <button name="%(dat_dashboard.action_repair_warranty_analysis)d"
                            type="action"
                            string="Reset"
                            class="btn-light"
                            icon="fa-refresh"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
