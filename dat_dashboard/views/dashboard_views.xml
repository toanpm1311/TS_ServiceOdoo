<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    The client action record to view the Dashboard-->
    <record id="dashboard_view_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">OdooDynamicDashboard</field>
    </record>
    <menuitem name="Dashboards" id="menu_dashboard" sequence="2"
              web_icon="dat_dashboard,static/description/icon.png"/>
    <menuitem name="Dashboard" action="dashboard_view_action"
              id="dashboard_root_menu"
              parent="dat_dashboard.menu_dashboard"
              sequence="0"/>
    <menuitem name="Reports" id="menu_helpdesk_reports"
              groups="dat_website_helpdesk.helpdesk_admin"
              parent="dat_dashboard.menu_dashboard" sequence="3"/>
</odoo>
