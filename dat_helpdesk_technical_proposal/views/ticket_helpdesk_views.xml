<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ticket_helpdesk_view_form_inherit" model="ir.ui.view">
        <field name="name">ticket.helpdesk.view.form.inherit</field>
        <field name="model">ticket.helpdesk</field>
        <field name="inherit_id" ref="dat_website_helpdesk.ticket_helpdesk_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header//button[@name='action_create_quotation']" position="after">
                <field name="technical_proposal_ids" invisible="1"/>
                <button name="action_create_material_proposal_with_json" string="Tạo đề xuất vật tư"
                            type="object" class="btn-primary"
                            groups="dat_website_helpdesk.helpdesk_admin"
                            invisible="status in ('closed', 'rejected')"/>
                <button name="action_create_technical_proposal" string="Create Technical Proposal" context="{'reject_button': True}"
                            type="object" class="btn-primary"
                            invisible="step_external_id != 'step_wf3_provide_tech_solutions' or technical_proposal_ids or uid != assigned_user_id"/>
            </xpath>
            <xpath expr="//sheet//button[@name='action_open_quotation']" position="after">
                <button class="oe_stat_button" name="action_open_technical_proposal" context="{'reject_button': True}"
                        string="Technical Proposal" type="object" icon="fa-tasks"
                        invisible="not (
                                    (wf_external_id == 'workflow_3'
                                            and step_external_id in ('step_wf3_provide_tech_solutions', 'step_wf3_approve_tech_solution', 'step_wf3_prepare_quotation', 'step_wf3_provide_quotation')
                                            and technical_proposal_ids)
                                    or (wf_external_id == 'workflow_4' and technical_proposal_ids)
                                    )">
                </button>
            </xpath>
        </field>
    </record>
</odoo>
