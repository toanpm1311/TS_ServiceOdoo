<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_template_inherit" inherit_id="sale.sale_order_portal_template"
              name="Sale Order Order Again">
        <xpath expr="//div[@name='order-info']" position="after">
                <div t-if="sale_order.final_sale_order_attachment_ids">
                    <div style="font-size: 14px; color:#666666;">Sale order attachments</div>
                    <div style="font-size: 16px;">
                        <t t-if="sale_order.final_sale_order_attachment_ids">
                            <t t-foreach="sale_order.final_sale_order_attachment_ids" t-as="attachment">
                                <div style="margin-bottom: 5px;">
                                    <a t-att-href="'/web/content/' + str(attachment.id)"
                                       t-att-download="attachment.name"
                                       style="text-decoration: none; color: #007bff;">
                                        <i class="fa fa-download" style="margin-right: 5px;"></i>
                                        <t t-esc="attachment.name"/>
                                    </a>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>
        </xpath>
    </template>

</odoo>
