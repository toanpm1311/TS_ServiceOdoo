<odoo>
    <record id="settings_view" model="ir.ui.view">
        <field name="name">res.config.settings.techservice.n8n</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="ts_techservice_n8n" string="TechService n8n" groups="base.group_system">
                    <block title="Gửi email và Teams riêng cho sale">
                        <setting string="Webhook production n8n">
                            <field name="ts_n8n_url" placeholder="https://n8n.example.com/webhook/techservice-notifications"/>
                        </setting>
                        <setting string="Token xác thực" help="Tạo Header Auth trên n8n: X-TechService-Token. Nhập cùng giá trị tại đây.">
                            <field name="ts_n8n_token" password="True"/>
                        </setting>
                        <setting string="Ngày nghỉ" help="Nhắc sau 3 ngày làm việc, không tính thứ Bảy, Chủ nhật và các ngày bên dưới.">
                            <field name="ts_n8n_holidays" placeholder="2026-01-01,2026-04-30"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
