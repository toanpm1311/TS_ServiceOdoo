<odoo>
    <record id="service_price_company_rule" model="ir.rule">
        <field name="name">Service price: allowed companies</field>
        <field name="model_id" ref="model_ts_service_price"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="notification_company_rule" model="ir.rule">
        <field name="name">Notification delivery: allowed companies</field>
        <field name="model_id" ref="model_ts_n8n_notification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
