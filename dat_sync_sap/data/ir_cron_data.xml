            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="save_log" eval="True"/>
            <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 17:00:00')"/>
        </record>
        <!-- Monthly -->
        <record forcecreate="True" id="ir_cron_sync_sap_working_time" model="ir.cron">
            <field name="name">SAP: Sync Working Time Data</field>
            <field name="model_id" ref="model_resource_calendar_attendance"/>
            <field name="state">code</field>
            <field name="code">model.sync_sap_data_for_period()</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="save_log" eval="True"/>
            <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 17:00:00')"/>
        </record>
    </data>
</odoo>
