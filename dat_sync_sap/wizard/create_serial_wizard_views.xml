<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_lot_tree_inherit_create_serial" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.create.serial</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="js_class">create_serial_item_list</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_kanban_inherit_create_serial" model="ir.ui.view">
        <field name="name">stock.lot.kanban.inherit.create.serial</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_form_popup" model="ir.ui.view">
        <field name="name">stock.lot.form.wizard</field>
        <field name="model">create.serial.wizard</field>
        <field name="arch" type="xml">
            <form string="Đồng bộ Serial Number" create="false" edit="false">
                <group>
                    <field name="sync_type"/>
                </group>
                <group>
                    <field name="partner_ids" widget="many2many_tags"
                           invisible="sync_type != 'partner'" required="sync_type == 'partner'"/>
                    <field name="serial_number"
                           invisible="sync_type != 'serial'" required="sync_type == 'serial'"/>
                    <field name="batch_size"
                           invisible="sync_type != 'existing'" required="sync_type == 'existing'"/>
                    <field name="last_batch_status" readonly="1"
                           invisible="sync_type != 'existing'"/>
                    <div class="alert alert-info" role="alert" invisible="sync_type != 'existing'">
                        Chỉ các serial đã tồn tại của công ty hiện tại được cập nhật.
                        Tác vụ chạy nền và tự tiếp tục từng batch khi đóng cửa sổ này.
                        Mở lại cửa sổ để xem tiến độ mới nhất.
                    </div>
                </group>
                <footer>
                    <button name="action_sync_serial_item" string="Đồng bộ" type="object"
                            class="btn-primary" invisible="sync_type == 'existing'"/>
                    <button name="action_sync_serial_item" string="Bắt đầu đồng bộ nền" type="object"
                            class="btn-primary" invisible="sync_type != 'existing'"
                            confirm="Hệ thống sẽ cập nhật lại dữ liệu của tất cả serial hiện có thuộc công ty hiện tại. Bạn muốn tiếp tục?"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
