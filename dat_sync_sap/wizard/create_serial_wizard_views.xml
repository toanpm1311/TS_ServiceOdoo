<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_lot_tree_inherit_create_serial" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.create.serial</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="js_class">create_serial_item_list</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_kanban_inherit_create_serial" model="ir.ui.view">
        <field name="name">stock.lot.kanban.inherit.create.serial</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_form_popup" model="ir.ui.view">
        <field name="name">stock.lot.form.wizard</field>
        <field name="model">create.serial.wizard</field>
        <field name="arch" type="xml">
            <form string="Đồng bộ Serial Number" create="false" edit="false">
                <group>
                    <field name="sync_type"/>
                </group>
                <group>
                    <field name="partner_ids" widget="many2many_tags"
                           invisible="sync_type != 'partner'" required="sync_type == 'partner'"/>
                    <field name="serial_number"
                           invisible="sync_type != 'serial'" required="sync_type == 'serial'"/>
                </group>
                <footer>
                    <button name="action_sync_serial_item" string="Đồng bộ" type="object" class="btn-primary"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo> 