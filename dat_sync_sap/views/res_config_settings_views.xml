<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dat_sync_sap" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.dat.sync.sap</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dat_sap_config.res_config_settings_view_form_dat_sap_config" />
        <field name="arch" type="xml">
            <xpath expr="//form/app[@name='dat_settings']/block[@name='sap_integration']/setting[@id='dat_settings_sap_api_connection']"
                position="after">
                <setting string="SAP Sync Manual" id="dat_settings_sap_sync_manual">
                    <button name="action_sync_sap_all" type="object" string="Sync All Data"
                        class="oe_highlight" />
                    <br />
                    <br />
                    <button name="action_sync_sap_specific_model" type="object"
                        string="Sync Specific Data" class="oe_highlight" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
