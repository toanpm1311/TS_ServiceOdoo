<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_sync_sap_sale" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sync.sap.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sync_sap_customer_data"
                        string="Lấy đồng bộ dữ liệu khách hàng"
                        type="object"
                        invisible="not partner_id"/>
                <button name="action_update_stock" invisible="not order_line"
                        string="Get On Hand Quantity" type="object" class="oe_highlight"/>
            </xpath>
        </field>
    </record>

</odoo>
