<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_inherit_sync_sap" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.sync.sap</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="dat_hr_employee.dat_hr_employee_view_form_inherit_hide_identification"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sap_information']" position="before">
                <div class="d-flex justify-content-end mb-2">
                    <button name="action_sync_current_employee_from_sap"
                            string="Đồng bộ lại từ SAP"
                            type="object"
                            class="btn btn-primary"
                            icon="fa-refresh"
                            groups="hr.group_hr_manager"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
