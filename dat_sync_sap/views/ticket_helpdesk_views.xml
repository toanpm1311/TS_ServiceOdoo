<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ticket_helpdesk_view_form_inherit_sync_sap" model="ir.ui.view">
        <field name="name">ticket.helpdesk.view.form.inherit.sync.sap</field>
        <field name="model">ticket.helpdesk</field>
        <field name="inherit_id" ref="dat_website_helpdesk.ticket_helpdesk_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sync_sap_customer_data"
                        string="Lấy đồng bộ dữ liệu khách hàng"
                        type="object"
                        invisible="not customer_id"/>
            </xpath>
            <xpath expr="//page[1]//field[@name='product_id']" position="after">
                <field name="replace_serial_number" string="S&#7889; seri thay th&#7871;" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='replace_serial_number'][@required=&quot;warranty_service_type == 'replace'&quot;]" position="after">
                <field name="bnk_replacement_so_status" readonly="1"/>
                <field name="bnk_replacement_sync_done" readonly="1"/>
                <field name="bnk_replacement_serial_sync_at" readonly="1"/>
                <field name="bnk_replacement_serial_sync_note" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
