<odoo>
    <record id="view_res_config_settings_energy_auto_assign" model="ir.ui.view">
        <field name="name">res.config.settings.energy.auto.assign</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="app_settings_block" string="Helpdesk (Energy)">
                    <h2>Helpdesk (Energy)</h2>
                    <div class="o_setting_container">

                        <div class="o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="ts_auto_assign_enable"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ts_auto_assign_enable"/>
                                <div class="text-muted">
                                    Tự động phân công phiếu helpdesk khi tạo mới theo Rule (Energy).
                                </div>
                            </div>
                        </div>

                        <div class="o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="ts_default_step_id"
                                       options="{'no_create_edit': True}"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ts_default_step_id"/>
                                <div class="text-muted">
                                    Bước mặc định nếu Rule không chỉ định bước.
                                </div>
                            </div>
                        </div>

                        <div class="o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="ts_auto_assign_domain"
                                       placeholder="[('department_id','in',[ref('dat_website_helpdesk.dep_energy_mb'), ref('dat_website_helpdesk.dep_energy_mt'), ref('dat_website_helpdesk.dep_energy_mn')])]"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ts_auto_assign_domain"/>
                                <div class="text-muted">
                                    Domain tham khảo cho mảng Năng lượng (chỉ để ghi chú, không bắt buộc).
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
