<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== TREE VIEW ===== -->
    <record id="view_ts_helpdesk_auto_assign_rule_tree" model="ir.ui.view">
        <field name="name">ts.helpdesk.auto.assign.rule.tree</field>
        <field name="model">ts.helpdesk.auto.assign.rule</field>
        <field name="arch" type="xml">
            <tree string="Rule phân công Helpdesk (Energy)" default_order="sequence asc">
                <field name="sequence"/>
                <field name="active"/>
                <field name="name"/>
                <field name="team_id"/>
                <field name="priority"/>
                <field name="user_id"/>
                <field name="stage_id"/>
            </tree>
        </field>
    </record>

    <!-- ===== FORM VIEW ===== -->
    <record id="view_ts_helpdesk_auto_assign_rule_form" model="ir.ui.view">
        <field name="name">ts.helpdesk.auto.assign.rule.form</field>
        <field name="model">ts.helpdesk.auto.assign.rule</field>
        <field name="arch" type="xml">
            <form string="Rule phân công Helpdesk (Energy)">
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="team_id" required="1"/>
                            <field name="priority"/>
                            <field name="user_id"/>
                            <field name="stage_id"/>
                        </group>
                    </group>

                    <group string="Nhắc việc">
                        <group>
                            <field name="activity_type_id"/>
                            <field name="activity_user_id"/>
                        </group>
                    </group>

                    <group string="Điều kiện bổ sung">
                        <field name="domain" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===== ACTION ===== -->
    <record id="action_ts_helpdesk_auto_assign_rule" model="ir.actions.act_window">
        <field name="name">Rule phân công Helpdesk (Energy)</field>
        <field name="res_model">ts.helpdesk.auto.assign.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo các rule để hệ thống tự động phân công ticket helpdesk cho đúng nhân viên.
            </p>
        </field>
    </record>

    <!-- ===== ROOT MENU / APP ===== -->
    <record id="menu_ts_helpdesk_auto_assign_rule_root" model="ir.ui.menu">
        <field name="name">Auto-Assign (Energy)</field>
        <field name="sequence">90</field>
        <field name="parent_id" eval="False"/>
        <field name="action" ref="action_ts_helpdesk_auto_assign_rule"/>
        <!-- cho user nội bộ + admin -->
        <field name="groups_id" eval="[(4, ref('base.group_user')), (4, ref('base.group_system'))]"/>
    </record>

</odoo>
