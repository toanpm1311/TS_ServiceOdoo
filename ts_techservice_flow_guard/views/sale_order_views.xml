<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_ts_flow_guard" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ts.flow.guard</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_sap_so_single" type="object" string="Tạo SO SAP" class="btn-primary"
                        invisible="not id or wf_external_id != 'workflow_1' or sap_status"/>
                <button name="action_duplicate_techservice_so" type="object" string="Nhân bản SO" class="btn-secondary"
                        invisible="not id"/>
                <button name="action_ts_open_merge_wizard" type="object" string="Gộp tạo báo giá"
                        class="btn-secondary"
                        invisible="not id or not ticket_id or state != 'draft' or status != 'draft' or sap_status or ts_merged_into_order_id"/>
                <button name="action_ts_bind_from_intermediate" type="object" string="Gắn từ kho trung gian"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ts_master_code" readonly="1"/>
                <field name="ts_customer_progress" readonly="1"/>
                <field name="ts_allow_post_so_price_edit"/>
                <field name="ts_price_impact_review_required" readonly="1"/>
                <field name="ts_last_price_change_at" readonly="1"/>
                <field name="ts_last_price_change_note" readonly="1"/>
                <field name="ts_pair_role" readonly="1"/>
                <field name="ts_pair_origin_order_id" readonly="1"/>
                <field name="ts_bound_stage" readonly="1"/>
                <field name="ts_merged_into_order_id" readonly="1"/>
                <field name="ts_quotation_ticket_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="ts_source_ticket_id" string="Ticket nguồn" optional="hide" readonly="1"/>
                <field name="ts_source_order_id" string="Báo giá nguồn" optional="hide" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Nhật ký Techservice">
                    <group>
                        <field name="ts_pair_order_ids" readonly="1">
                            <tree create="false" delete="false">
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="amount_total"/>
                                <field name="state"/>
                                <field name="ts_pair_role"/>
                            </tree>
                        </field>
                        <field name="ts_merged_source_order_ids" readonly="1">
                            <tree create="false" delete="false">
                                <field name="name"/>
                                <field name="ticket_id"/>
                                <field name="amount_total"/>
                                <field name="state"/>
                                <field name="status"/>
                            </tree>
                        </field>
                    </group>
                    <field name="ts_audit_log_ids" readonly="1">
                        <tree create="false" delete="false">
                            <field name="change_date"/>
                            <field name="changed_by"/>
                            <field name="change_scope"/>
                            <field name="change_type"/>
                            <field name="field_name"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="reason"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_ts_sale_order_merge_wizard_form" model="ir.ui.view">
        <field name="name">ts.sale.order.merge.wizard.form</field>
        <field name="model">ts.sale.order.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Gộp báo giá Techservice">
                <group>
                    <field name="base_order_id"/>
                    <field name="customer_id" readonly="1"/>
                    <field name="merge_order_ids" widget="many2many_tags"
                           domain="[('id', '!=', base_order_id),
                                    ('ts_merge_customer_id', '=', customer_id),
                                    ('company_id', '=', base_order_id.company_id),
                                    ('state', '=', 'draft'),
                                    ('status', '=', 'draft'),
                                    ('sap_status', '=', False),
                                    ('ts_merged_into_order_id', '=', False)]"/>
                    <field name="summary" readonly="1"/>
                </group>
                <footer>
                    <button name="action_merge_orders" type="object" string="Gộp tạo báo giá" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ts_merge_quotations" model="ir.actions.server">
        <field name="name">Gộp tạo báo giá</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_ts_open_merge_wizard()</field>
    </record>

    <record id="sale_order_view_tree_inherit_ts_merge_button" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.ts.merge.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="dat_website_helpdesk.sale_order_view_tree_inherit_sap_batch"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//tree/header" position="inside">
                <button name="%(action_ts_merge_quotations)d"
                        type="action"
                        string="Gộp tạo báo giá"
                        class="btn btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
