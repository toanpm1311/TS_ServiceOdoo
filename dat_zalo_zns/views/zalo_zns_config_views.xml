<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zalo_zns_config_view_tree" model="ir.ui.view">
        <field name="name">zalo.zns.config.tree</field>
        <field name="model">zalo.zns.config</field>
        <field name="arch" type="xml">
            <tree string="Zalo ZNS Configuration">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="oa_name" />
                <field name="oa_id" />
                <field name="app_id" />
                <field name="api_base_url" />
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="zalo_zns_config_view_form" model="ir.ui.view">
        <field name="name">zalo.zns.config.form</field>
        <field name="model">zalo.zns.config</field>
        <field name="arch" type="xml">
            <form string="Zalo ZNS Configuration">
                <sheet>
                    <group>
                        <group name="app_info" string="Application / Official Account">
                            <field name="name" />
                            <field name="app_id" password="True" />
                            <field name="oa_name" />
                            <field name="oa_id" />
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group name="config_info" string="Configuration Information">
                            <field name="sequence" />
                            <field name="api_base_url" />
                            <field name="oauth_api_url" />
                            <field name="access_token" password="True" />
                            <field name="access_token_expires_at" readonly="True" />
                            <field name="refresh_token" password="True" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zalo_zns_config" model="ir.actions.act_window">
        <field name="name">Zalo ZNS Configuration</field>
        <field name="res_model">zalo.zns.config</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('zalo_zns_config_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('zalo_zns_config_view_form')})]" />
    </record>
</odoo>
