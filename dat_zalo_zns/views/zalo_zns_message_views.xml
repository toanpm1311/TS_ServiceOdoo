<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zalo_zns_message_tree" model="ir.ui.view">
        <field name="name">zalo.zns.message.tree</field>
        <field name="model">zalo.zns.message</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="template_id" />
                <field name="error_message" />
                <field name="phone" />
                <field name="zalo_user_id_zalo" optional="hide" />
                <field name="zalo_msg_id" optional="hide" />
                <field
                    name="state"
                    decoration-success="state == 'done'"
                    decoration-warning="state == 'failed'"
                    decoration-info="state == 'draft'"
                    decoration-danger="state == 'sent'"
                    widget="badge"
                    optional="show"
                />
            </tree>
        </field>
    </record>

    <record id="view_zalo_zns_message_form" model="ir.ui.view">
        <field name="name">zalo.zns.message.form</field>
        <field name="model">zalo.zns.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_message_zalo_zns" string="Send Message" type="object"
                        class="oe_highlight" />
                    <button name="action_update_status_send_zns_from_zalo"
                        string="Update status form Zalo" invisible="state != 'sent'" type="object"
                        class="oe_highlight" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="template_id" />
                        <field name="template_model" invisible="1" />
                        <field name="name" />
                        <field name="phone" />
                        <field name="model_id" readonly="1" />
                        <field name="record_id" readonly="1" />
                        <field name="zalo_msg_id" />
                        <field name="zalo_user_id_zalo" readonly="1" />
                        <field name="zalo_msg_str" readonly="1" />
                        <field name="error_message" invisible="state != 'failed'" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="action_zalo_zns_message" model="ir.actions.act_window">
        <field name="name">Zalo ZNS Messages</field>
        <field name="res_model">zalo.zns.message</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
