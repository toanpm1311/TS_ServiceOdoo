<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_sap_sale" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sap.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="customer_contact_name"/>
                <field name="is_helpdesk_admin" invisible="1"/>
            </field>
            <xpath expr="//header" position="inside">
                <button name="action_open_reject_wizard"
                        invisible="status in ('draft', 'confirmed', 'rejected', 'cancelled') or not id" string="Reject"
                        type="object"/>
                <field name="status" widget="statusbar" options="{'clickable': False}" invisible="not id"/>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm']" position="after">
                <button name="action_confirm_status" string="Confirm"
                        invisible="status in ('confirmed','rejected','cancelled') or not id  or (wf_external_id == 'workflow_3' and step_external_id != 'step_wf3_provide_quotation')"
                        type="object"
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">status in ('confirmed','rejected','cancelled') or not id or (wf_external_id == 'workflow_3' and step_external_id != 'step_wf3_provide_quotation')</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_quotation_send']" position="replace">
                <button name="action_waiting_for_confirm" string="Waiting for Confirm"
                        invisible="status not in ('draft') or not id or (wf_external_id == 'workflow_3' and step_external_id != 'step_wf3_provide_quotation')"
                        type="object"
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//header/button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="invisible">status in ('confirmed','rejected','cancelled') or not id or (wf_external_id == 'workflow_3' and step_external_id != 'step_wf3_provide_quotation')</attribute>
            </xpath>
            <field name="payment_term_id" position="after">
                <field name="cancel_reason" invisible="state != 'cancel'" readonly="1"/>
                <field name="reject_reason" invisible="status != 'rejected'" readonly="1"/>
            </field>
            <xpath expr="//form" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
            <xpath expr="//form/sheet//notebook" position="inside">
                <page string="Other Infor" name="dat_other_information">
                    <group name="sale_shipping" string="Shipping">
                        <field name="incoterm" options="{'no_open': True, 'no_create': True}" invisible="1"/>
                        <field name="incoterm_location" invisible="1"/>
                        <field name="picking_policy" required="True"
                               readonly="state not in ['draft', 'sent']"/>
                        <field name="commitment_date" readonly="state == 'cancel' or locked"/>
                        <field name="expected_date" class="oe_inline" widget="date"/>
                    </group>
                    <group string="Notes">
                        <field colspan="2" name="note" nolabel="1"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//form/sheet//notebook//page[@name='order_lines']//tree/control/create[@name='add_section_control']"
                   position="replace"/>
            <xpath expr="//form/sheet//notebook//page[@name='order_lines']//tree/control/create[@name='add_note_control']"
                   position="replace"/>
            <xpath expr="//form/sheet//notebook//page[@name='order_lines']//tree/control/button[@name='action_add_from_catalog']"
                   position="replace"/>
            <xpath expr="//form/sheet//notebook//page[@name='order_lines']//tree/field[@name='name']"
                   position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//form/sheet//notebook//page[@name='order_lines']//field[@name='order_line']"
                    position="attributes">
                <attribute name="readonly">status not in ('draft') and not is_helpdesk_admin</attribute>
            </xpath>
            <xpath expr="//form/sheet//notebook//page[@name='order_lines']//tree/field[@name='product_template_id']"
                   position="attributes">
                <attribute name="readonly">id</attribute>
            </xpath>
            <xpath expr="//form/sheet//notebook//page[@name='order_lines']//tree/field[@name='product_uom_qty']"
                   position="after">
                <field name="filler_warehouse_id"
                    required="wf_external_id == 'workflow_1'"
                    options="{'no_create': True}"/>
                <field name="onhand_quantity" string="On Hand Quantity"/>
                <field name="sap_is_discount"/>
                <field name="sap_discount_amount"/>
                <field name="discount"/>
                <field name="sap_wmonth"/>
                <field name="create_sap"/>
                <field name="wf_external_id" column_invisible="1" />
            </xpath>
            <xpath expr="//form/sheet//notebook//page[@name='order_lines']//tree/field[@name='product_uom_qty']"
                   position="before">
                <field name="product_uom" readonly="1"/>
            </xpath>
            <xpath
                    expr="//form/sheet//notebook//page[@name='order_lines']//tree/field[@name='price_total']"
                    position="attributes">
                <attribute name="string">Total</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath
                    expr="//form/sheet//notebook//page[@name='order_lines']//field[@name='tax_totals']"
                    position="after">
                <field name="formated_amount_total" string="Total All" style="font-weight: bold;"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="before">
                <button name="action_import_products"
                        invisible="wf_external_id != 'workflow_1' or status not in ['draft'] " string="Import Products"
                        type="object" class="btn-secondary"/>
                <button name="action_refresh_dat_price_list"
                        invisible="wf_external_id != 'workflow_1' or status != 'draft'"
                        string="L&#7845;y gi&#225; Price List"
                        type="object"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_tree_inherit_sap_sale" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.sap.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="status" widget="badge"
                       decoration-primary="status == 'draft'"
                       decoration-info="status == 'waiting'"
                       decoration-success="status == 'confirmed'"
                       decoration-danger="status == 'rejected'"
                       decoration-warning="status == 'cancelled'"
                />
            </field>
        </field>
    </record>
</odoo>
