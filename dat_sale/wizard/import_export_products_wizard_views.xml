<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quotation_product_import_wizard_form" model="ir.ui.view">
        <field name="name">quotation.product.import.wizard.form</field>
        <field name="model">quotation.product.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Products">
                <header>
                    <button name="action_export_products" string="Get Template" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="import_product_data" string="Import" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_quotation_product_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Products</field>
        <field name="res_model">quotation.product.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>