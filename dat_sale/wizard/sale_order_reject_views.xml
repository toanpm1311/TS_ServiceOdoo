<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_reject_wizard_view_form" model="ir.ui.view">
            <field name="name">sale.order.reject.wizard.view.form</field>
            <field name="model">sale.order.reject</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="sale_order_id" invisible="1"/>
                            <field name="reject_reason"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_reject" string="Reject Ticket" type="object"
                            class="oe_highlight" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
