<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_cancel_view_form_inherit_dat_sale" model="ir.ui.view">
        <field name="name">sale.order.cancel.form.inherit.dat.sale</field>
        <field name="model">sale.order.cancel</field>
        <field name="inherit_id" ref="sale.sale_order_cancel_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='body']" position="after">
                <label for="cancel_reason" string="Reason"/>
                <field name="cancel_reason"/>
            </xpath>
        </field>
    </record>
</odoo>
