<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <function model="ir.rule" name="write">
            <value model="ir.rule"
                   search="[('model_id.model', '=', 'ticket.helpdesk'), ('domain_force', 'ilike', 'team_id.member_ids')]"/>
            <value eval="{'active': False}"/>
        </function>

        <function model="ir.model.data" name="write">
            <value model="ir.model.data"
                   search="[('module', '=', 'dat_helpdesk_steps_sla'), ('name', '=', 'help_desk_dashboard_my_ticket_all_step')]"/>
            <value eval="{'noupdate': False}"/>
        </function>

        <record id="help_desk_dashboard_my_ticket_all_step"
                model="ir.rule">
            <field name="name">Record Rule For My Tickets In All Step</field>
            <field ref="model_ticket_helpdesk" name="model_id"/>
            <field name="groups"
                   eval="[(4, ref('dat_website_helpdesk.helpdesk_user'))]"/>
            <field name="domain_force">
                ['|', '|', '|',
                    ('create_uid', '=', user.id),
                    ('assigned_user_id', '=', user.id),
                    ('assigned_follower_ids', 'in', [user.id]),
                    ('message_follower_ids.partner_id', '=', user.partner_id.id)
                ] if not user.has_group('dat_website_helpdesk.helpdesk_admin') else [('id', '=', 0)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <function model="ir.rule" name="write">
            <value model="ir.rule"
                   search="[('model_id.model', '=', 'ticket.helpdesk'), ('name', '=', 'Record Rule For My Tickets In All Step')]"/>
            <value eval="{
                'active': True,
                'perm_read': True,
                'perm_write': True,
                'perm_create': True,
                'perm_unlink': True,
            }"/>
        </function>

        <function model="ir.model.data" name="write">
            <value model="ir.model.data"
                   search="[('module', '=', 'dat_helpdesk_steps_sla'), ('name', '=', 'help_desk_dashboard_my_ticket_all_step')]"/>
            <value eval="{'noupdate': True}"/>
        </function>
    </data>
</odoo>
