<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_department_form_inherit_no_domain" model="ir.ui.view">
        <field name="name">hr.department.form.remove.manager.domain</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="attributes">
                <attribute name="domain">[]</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_hr_department_tree_inherit_no_domain" model="ir.ui.view">
        <field name="name">hr.department.tree.remove.manager.domain</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="attributes">
                <attribute name="domain">[]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
