<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit_hide_identification" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hide.identification</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="70"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='application_group']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_form_inherit_hide_time_off_buttons" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hide.time.off.buttons</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_holidays.view_employee_form_leave_inherit"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_time_off_dashboard'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_time_off_dashboard'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_form_inherit_hide_timesheet_buttons" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hide.timesheet.buttons</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_timesheet.hr_employee_view_form_inherit_timesheet"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_timesheet_from_employee']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
