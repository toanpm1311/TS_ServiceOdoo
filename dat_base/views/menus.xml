<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- 1. Customer Portal -->
    <menuitem name="Customer Portal"
            id="website.menu_website_configuration"
            sequence="99"/>

    <!-- 2. Product & Warranty Inventory Management -->
    <menuitem name="Product  &amp; Warranty Inventory"
              id="stock.menu_stock_root"
            sequence="3"/>

    <record model="ir.ui.menu" id="stock.stock_picking_type_menu">
        <field name="active" eval="False"/>
    </record>

    <record model="ir.ui.menu" id="stock.menu_stock_warehouse_mgmt">
