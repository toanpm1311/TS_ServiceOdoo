<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_inherit_hide_sale_order_buttons" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.hide.sale.order.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="sale.res_partner_view_buttons"/>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_form_inherit_hide_timesheet_buttons" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.hide.invoiced.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.partner_view_buttons"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_partner_invoices']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
