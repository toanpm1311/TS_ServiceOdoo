<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ticket_return_wizard_view_form" model="ir.ui.view">
            <field name="name">ticket.return.wizard.view.form</field>
            <field name="model">ticket.return.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="ticket_id" invisible="1"/>
                            <field name="return_reason"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_return" string="Return Ticket" type="object"
                            class="oe_highlight" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
