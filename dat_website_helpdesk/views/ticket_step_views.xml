<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    Step form view-->
    <record id="ticket_step_view_form" model="ir.ui.view">
        <field name="name">ticket.step.view.form</field>
        <field name="model">ticket.step</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="workflow_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="closing_step" invisible="1"/>
                            <field name="group_ids" widget="many2many_tags" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--Step tree view-->
    <record id="ticket_step_view_tree" model="ir.ui.view">
        <field name="name">ticket.step.view.tree</field>
        <field name="model">ticket.step</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="workflow_id"/>
                <field name="sequence"/>
            </tree>
        </field>
    </record>
    <!--Action for ticket step model.-->
    <record id="action_helpdesk_step" model="ir.actions.act_window">
        <field name="name">Steps</field>
        <field name="res_model">ticket.step</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
