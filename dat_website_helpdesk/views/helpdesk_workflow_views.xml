<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="helpdesk_workflow_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.workflow.view.tree</field>
        <field name="model">helpdesk.workflow</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="helpdesk_workflow_view_form" model="ir.ui.view">
        <field name="name">helpdesk.workflow.view.form</field>
        <field name="model">helpdesk.workflow</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Step">
                            <field name="step_ids">
                                <tree editable="bottom" delete="false" create="false">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_workflow" model="ir.actions.act_window">
        <field name="name">Helpdesk Workflow</field>
        <field name="res_model">helpdesk.workflow</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
