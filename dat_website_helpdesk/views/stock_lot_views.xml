<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="stock_lot_view_form_inherit_dat_website_helpdesk" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.dat.website.helpdesk</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet//group[@name='main_group']" position="replace">
                <group name="main_group">
                    <group>
                        <field name="product_id"
                               context="{'default_detailed_type': 'product', 'default_tracking': 'lot', 'active_test': False}"
                               readonly="context.get('set_product_readonly', False)" force_save="1"
                               help="Product this lot/serial number contains. You cannot change it anymore if it has already been moved."/>
                        <label for="product_qty" invisible="not display_complete"/>
                        <div class="o_row" invisible="not display_complete">
                            <field name="product_qty"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                        </div>
                        <field name="ref"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="location_id" invisible="not location_id" groups="stock.group_stock_manager"/>
                        <field name="last_delivery_partner_id" invisible="not last_delivery_partner_id"
                               groups="stock.group_stock_manager"/>
                        <field name="replaced_by" invisible="not replaced_by" readonly="1"/>
                    </group>
                    <group>
                        <field name="buyer_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="buyer_phone"/>
                        <field name="owner_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="owner_phone"/>
                        <field name="saleperson_id"/>
                        <field name="branch"/>
                        <field name="department_id"/>
                    </group>
                    <field name="lot_properties" nolabel="1" columns="2" hideAddButton="1"/>
                </group>
            </xpath>
            <xpath expr="//form//notebook" position="inside">
                <page string="Helpdesk Tickets" name="helpdesk_tickets">
                    <field name="helpdesk_ticket_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="create_date"/>
                            <field name="ticket_type_id"/>
                            <field name="request_type"/>
                            <field name="status"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//form//notebook/page[@name='description']" position="before">
                <page string="Warranty Status" name="warranty_status">
                    <group>
                        <field name="warranty_start_date"/>
                        <field name="warranty_month"/>
                        <field name="warranty_end_date" readonly="1"/>
                        <field name="warranty_status"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//form//notebook/page[@name='description']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="dat_view_stock_lot_tree_inherit" model="ir.ui.view">
        <field name="name">dat.stock.lot.view.tree.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="buyer_id"/>
                <field name="owner_id"/>
            </xpath>
            <xpath expr="field[@name='create_date']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="field[@name='activity_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>

    </record>

    <record id="search_product_lot_filter_inherit" model="ir.ui.view">
        <field name="name">Production Lots Filter Inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="owner_phone"/>
                <field name="helpdesk_ticket_ids" filter_domain="[('helpdesk_ticket_ids.name', 'ilike', self)]"/>
                <field name="owner_id" filter_domain="[('owner_id.name', 'ilike', self)]"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_properties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='create_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
