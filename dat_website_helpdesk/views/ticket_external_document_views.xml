<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ticket_external_document_view_tree" model="ir.ui.view">
        <field name="name">ticket.external.document.tree</field>
        <field name="model">ticket.external.document</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="create_date" string="Thời gian"/>
                <field name="operation_name"/>
                <field name="document_number"/>
                <field name="sale_order_id"/>
                <field name="create_uid" string="Người thực hiện"/>
            </tree>
        </field>
    </record>

    <record id="ticket_external_document_view_form" model="ir.ui.view">
        <field name="name">ticket.external.document.form</field>
        <field name="model">ticket.external.document</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="ticket_id"/>
                        <field name="sale_order_id"/>
                        <field name="operation_name"/>
                        <field name="document_number"/>
                        <field name="create_date"/>
                        <field name="create_uid"/>
                    </group>
                    <group string="Phản hồi hệ thống ngoài">
                        <field name="response_data" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ticket_external_document_confirm_view_form" model="ir.ui.view">
        <field name="name">ticket.external.document.confirm.form</field>
        <field name="model">ticket.external.document.confirm</field>
        <field name="arch" type="xml">
            <form string="Xác nhận tạo lại chứng từ">
                <group>
                    <field name="warning_message" nolabel="1" readonly="1"/>
                    <field name="operation_name"/>
                    <field name="previous_document_numbers"/>
                    <field name="ticket_id" invisible="1"/>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="operation" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Vẫn tạo mới" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ticket_helpdesk_external_document_view_form" model="ir.ui.view">
        <field name="name">ticket.helpdesk.external.document.form</field>
        <field name="model">ticket.helpdesk</field>
        <field name="inherit_id" ref="dat_website_helpdesk.ticket_helpdesk_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_external_document_history" type="object"
                        class="oe_stat_button" icon="fa-history"
                        invisible="external_document_count == 0">
                    <field name="external_document_count" widget="statinfo" string="Lịch sử chứng từ"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
