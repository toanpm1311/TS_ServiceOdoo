<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ticket_priority_view_tree" model="ir.ui.view">
        <field name="name">ticket.priority.view.tree</field>
        <field name="model">ticket.priority</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="percentage_hours"/>
                <field name="default" readonly="1"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.server" id="action_choose_default_priority">
       <field name="name">Choose Default</field>
       <field name="model_id" ref="dat_website_helpdesk.model_ticket_priority"/>
       <field name="binding_model_id" ref="dat_website_helpdesk.model_ticket_priority"/>
       <field name="state">code</field>
       <field name="code">
           action = records.choose_default()
       </field>
   </record>

    <record id="action_ticket_priority" model="ir.actions.act_window">
        <field name="name">Priority</field>
        <field name="res_model">ticket.priority</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
    </record>
</odoo>
