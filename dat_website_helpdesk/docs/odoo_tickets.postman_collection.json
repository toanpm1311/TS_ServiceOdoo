{
  "info": {
    "name": "Odoo Local - Phieu ho tro",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Nhap username/password tai khoan Odoo trong Variables. Chay 1. Dang nhap Odoo, sau do 2. Lay phieu ho tro. Postman luu cookie session_id cho localhost. Khong dung token auth.datgroup.com.vn."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5050",
      "type": "string"
    },
    {
      "key": "db",
      "value": "sv666",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "owner_name",
      "value": "TEN KHACH HANG SO HUU",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Dang nhap Odoo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"db\": \"{{db}}\",\n    \"login\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n  },\n  \"id\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/web/session/authenticate"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Odoo login succeeds\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.error, \"Odoo login error\").to.be.undefined;",
              "    pm.expect(body.result && body.result.uid, \"Odoo user ID\").to.be.a(\"number\").above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Lay phieu ho tro",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/tickets/?page=1&page_size=80"
      }
    },
    {
      "name": "3. Tim phieu theo ten khach hang so huu",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/tickets/?page=1&page_size=80&owner_name={{owner_name}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "tickets",
            ""
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "80"
            },
            {
              "key": "owner_name",
              "value": "{{owner_name}}"
            }
          ]
        },
        "description": "Dien owner_name bang ten cong ty, ten hien thi day du (ten cong ty, ten lien he) hoac ten lien he. Khop chinh xac ca chu hoa/thuong. Thay owner_name bang customer_name de tim khach hang yeu cau. Response owner_id.display_name la ten hien thi tren Odoo; owner_id.name la ten lien he."
      }
    },
    {
      "name": "4. Tim tat ca phieu theo owner_name trong Body JSON",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"owner_name\": \"{{owner_name}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Dien owner_name bang ten cong ty, ten hien thi day du (ten cong ty, ten lien he) hoac ten lien he. Chay dang nhap truoc. Gui Body JSON, khong can Params; tra tat ca phieu duoc phep xem khop ten, khong phan trang. Doi chieu ten voi owner_id.display_name."
      }
    }
  ]
}
