<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Step of the workflow1 Warranty and Repair Request Processing -->
        <record id="step_wf1_receiving_and_inspection" model="ticket.step">
            <field name="sequence">0</field>
            <field name="name">Assign</field>
        </record>
        <record id="step_wf1_receiving" model="ticket.step">
            <field name="sequence">1</field>
            <field name="name">Receiving</field>
        </record>
        <record id="step_wf1_repair_quotation" model="ticket.step">
            <field name="sequence">2</field>
            <field name="name">Repair Quotation</field>
        </record>
        <record id="step_wf1_material_dispatch" model="ticket.step">
            <field name="sequence">3</field>
            <field name="name">Material Dispatch</field>
        </record>
        <record id="step_wf1_repair" model="ticket.step">
            <field name="sequence">4</field>
            <field name="name">Repair</field>
        </record>

        <!-- NEW: WF1_STEP_5A - Replace gate (received defective + replace serial) -->
        <record id="step_wf1_confirm_replace_and_serial" model="ticket.step">
            <field name="sequence">5</field>
            <field name="name">Confirm Replace / Received Defective &amp; Replace Serial</field>
        </record>

        <record id="step_wf1_reassembly_to_original_state" model="ticket.step">
            <field name="sequence">6</field>
            <field name="name">Reassemble to Original State</field>
        </record>
        <record id="step_wf1_product_delivery" model="ticket.step">
            <field name="sequence">7</field>
            <field name="name">Product Delivery</field>
        </record>
        <record id="step_wf1_on_site_installation_and_repair" model="ticket.step">
            <field name="sequence">8</field>
            <field name="name">On-site Installation and Repair</field>
        </record>

        <!-- NEW: WF1_STEP_9 - Technical done / close -->
        <record id="step_wf1_technical_done_close" model="ticket.step">
            <field name="sequence">9</field>
            <field name="name">Technical Done / Close</field>
        </record>

        <!-- Step of the workflow2 On-Site Repair and Installation Request Processing -->
        <record id="step_wf2_receiving_and_inspection" model="ticket.step">
            <field name="sequence">0</field>
            <field name="name">Assign</field>
        </record>
        <record id="step_wf2_receiving" model="ticket.step">
            <field name="sequence">1</field>
            <field name="name">Receiving</field>
        </record>
        <record id="step_wf2_go_to_location" model="ticket.step">
            <field name="sequence">2</field>
            <field name="name">Go to location</field>
        </record>
        <record id="step_wf2_begin_processing" model="ticket.step">
            <field name="sequence">3</field>
            <field name="name">Begin processing</field>
        </record>
        <record id="step_wf2_installation_completed" model="ticket.step">
            <field name="sequence">4</field>
            <field name="name">Installation completed</field>
        </record>
        <record id="step_wf2_approval" model="ticket.step">
            <field name="sequence">5</field>
            <field name="name">Approval</field>
        </record>

        <!-- Step of the workflow3 Technical Solution Provision Request Processing -->
        <record id="step_wf3_receiving_and_inspection" model="ticket.step">
            <field name="sequence">0</field>
            <field name="name">Assign</field>
        </record>
        <record id="step_wf3_receiving" model="ticket.step">
            <field name="sequence">1</field>
            <field name="name">Receiving</field>
        </record>
        <record id="step_wf3_survey_tech_solutions" model="ticket.step">
            <field name="sequence">2</field>
            <field name="name">Survey and propose technical solutions</field>
        </record>
        <record id="step_wf3_feedback_survey_results" model="ticket.step">
            <field name="sequence">3</field>
            <field name="name">Feedback on consultation and survey results</field>
        </record>
        <record id="step_wf3_approve_survey_results" model="ticket.step">
            <field name="sequence">4</field>
            <field name="name">Approve consultation and survey results</field>
        </record>
        <record id="step_wf3_provide_tech_solutions" model="ticket.step">
            <field name="sequence">5</field>
            <field name="name">Provide feasible technical solutions</field>
        </record>
        <record id="step_wf3_approve_tech_solution" model="ticket.step">
            <field name="sequence">6</field>
            <field name="name">Approve technical solution</field>
        </record>
        <record id="step_wf3_prepare_quotation" model="ticket.step">
            <field name="sequence">7</field>
            <field name="name">Prepare a quotation</field>
        </record>
        <record id="step_wf3_provide_quotation" model="ticket.step">
            <field name="sequence">8</field>
            <field name="name">Provide a quotation to the customer</field>
        </record>

        <!-- Step of the workflow4 Technical Solution Deployment Request Processing -->
        <record id="step_wf4_receiving_and_inspection" model="ticket.step">
            <field name="sequence">0</field>
            <field name="name">Assign</field>
        </record>
        <record id="step_wf4_receiving" model="ticket.step">
            <field name="sequence">1</field>
            <field name="name">Receiving</field>
        </record>
        <record id="step_wf4_plan_deployment" model="ticket.step">
            <field name="sequence">2</field>
            <field name="name">Plan the deployment of the technical solution</field>
        </record>
        <record id="step_wf4_receive_equipment_docs" model="ticket.step">
            <field name="sequence">3</field>
            <field name="name">Receive equipment/technical solution documents and materials</field>
        </record>
        <record id="step_wf4_dat_deploy_tech_solution_and_handle_errors" model="ticket.step">
            <field name="sequence">4</field>
            <field name="name">DAT deploys and operates the technical solution</field>
        </record>
        <record id="step_wf4_handover_solution" model="ticket.step">
            <field name="sequence">5</field>
            <field name="name">Hand over the solution to the customer</field>
        </record>
        <record id="step_wf4_acceptance_completion" model="ticket.step">
            <field name="sequence">6</field>
            <field name="name">Acceptance and completion of project documentation</field>
        </record>
        <record id="step_wf4_follow_up" model="ticket.step">
            <field name="sequence">99</field>
            <field name="name">Follow-Up</field>
        </record>
        <record id="step_rejected" model="ticket.step">
            <field name="sequence">100</field>
            <field name="name">Rejected</field>
        </record>
    </data>
</odoo>
