                    ref('dat_website_helpdesk.field_ticket_helpdesk__plc_point'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__hmi_point'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__cabinet_enclosure_point'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__installation_capacity'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__quotation_task_result'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__quotation_task_link'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__quotation_approval_result'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__quotation_reject_reason'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__quotation_reject_reason_other'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__expected_implementation_date'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__expected_implementation_address'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__equipment_attachment_ids'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__technical_solution_design_attachment_ids'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__materials_attachment_ids'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__handover_result'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__acceptance_result'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__acceptance_attachment_ids'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__acceptance_design_attachment_ids')
                ])]"/>
        </record>

        <record id="actions_send_noti_when_ticket_helpdesk_updated" model="ir.actions.server">
            <field name="name">Send notification: Ticket Helpdesk Updated</field>
            <field name="is_changes_updated_notification">1</field>
            <field name="model_id" ref="dat_website_helpdesk.model_ticket_helpdesk"/>
            <field name="base_automation_id" ref="dat_website_helpdesk.base_automation_trigger_actions_ticket_helpdesk_updated"/>
            <field name="state">code</field>
            <field name="code">
template = env.ref('dat_website_helpdesk.notification_template_ticket_updated')
current_action = env.ref('dat_website_helpdesk.actions_send_noti_when_ticket_helpdesk_updated')
user_ids = record.assigned_user_id - record.write_uid
if template and user_ids:
    changed_fields = env.context.get('changed_fields', [])
    changed_fields_str = ', '.join(changed_fields) if changed_fields else ''
    template.send_notification(res_ids=[record.id], recipient_ids=user_ids.partner_id.ids, current_action=current_action, add_context={'changed_fields': changed_fields_str})
            </field>
        </record>
    </data>
</odoo>
