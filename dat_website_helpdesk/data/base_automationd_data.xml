                    ref('dat_website_helpdesk.field_ticket_helpdesk__warranty_service_type'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__status_before_repair'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__status_after_repair'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__replace_serial_number'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__product_status_before'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__product_status_image_before_ids'),
                    ref('dat_website_helpdesk.field_ticket_helpdesk__product_status_after'),
