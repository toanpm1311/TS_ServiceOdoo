<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data >
        <!-- Trigger actions when Ticket Helpdesk assigned -->
        <record id="base_automation_trigger_actions_ticket_helpdesk_assigned" model="base.automation">
            <field name="trigger">on_create_or_write</field>
            <field name="name">Auto Send Notification When Ticket Helpdesk Assigned</field>
            <field name="model_id" ref="dat_website_helpdesk.model_ticket_helpdesk"/>
            <field name="filter_pre_domain">[]</field>
            <field name="filter_domain">[('assigned_user_id', '!=', False), ('status', 'not in', ['closed', 'rejected', 'on_hold'])]</field>
            <field name="trigger_field_ids" eval="[(6, 0, [ref('dat_website_helpdesk.field_ticket_helpdesk__assigned_user_id')])]"/>
        </record>

        <record id="actions_send_noti_when_ticket_helpdesk_assigned" model="ir.actions.server">
            <field name="name">Send notification: Ticket Helpdesk Assigned</field>
            <field name="is_changes_updated_notification">1</field>
            <field name="model_id" ref="dat_website_helpdesk.model_ticket_helpdesk"/>
            <field name="base_automation_id" ref="dat_website_helpdesk.base_automation_trigger_actions_ticket_helpdesk_assigned"/>
            <field name="state">code</field>
            <field name="code">
template = env.ref('dat_website_helpdesk.notification_template_new_ticket')
current_action = env.ref('dat_website_helpdesk.actions_send_noti_when_ticket_helpdesk_assigned')
user_ids = record.assigned_user_id
if template and user_ids:
    template.send_notification(res_ids=[record.id], recipient_ids=user_ids.partner_id.ids, current_action=current_action)
            </field>
        </record>

        <!-- Trigger actions when Ticket Helpdesk canceled -->
        <record id="base_automation_trigger_actions_ticket_helpdesk_canceled" model="base.automation">
            <field name="trigger">on_write</field>
            <field name="name">Auto Send Notification When Ticket Helpdesk Canceled</field>
            <field name="model_id" ref="dat_website_helpdesk.model_ticket_helpdesk"/>
            <field name="filter_pre_domain">[('id', '!=', False), ('status', 'not in', ['rejected', 'closed'])]</field>
            <field name="filter_domain">[('assigned_user_id', '!=', False), ('status', '=', 'rejected')]</field>
            <field name="trigger_field_ids" eval="[(6, 0, [ref('dat_website_helpdesk.field_ticket_helpdesk__status')])]"/>
        </record>

        <record id="actions_send_noti_when_ticket_helpdesk_canceled" model="ir.actions.server">
            <field name="name">Send notification: Ticket Helpdesk Canceled</field>
            <field name="is_changes_updated_notification">1</field>
            <field name="model_id" ref="dat_website_helpdesk.model_ticket_helpdesk"/>
            <field name="base_automation_id" ref="dat_website_helpdesk.base_automation_trigger_actions_ticket_helpdesk_canceled"/>
            <field name="state">code</field>
            <field name="code">
template = env.ref('dat_website_helpdesk.notification_template_ticket_canceled')
current_action = env.ref('dat_website_helpdesk.actions_send_noti_when_ticket_helpdesk_canceled')
user_ids = record.assigned_user_id - record.write_uid
if template and user_ids:
    template.send_notification(res_ids=[record.id], recipient_ids=user_ids.partner_id.ids, current_action=current_action)
            </field>
        </record>

