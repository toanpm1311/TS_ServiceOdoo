<odoo>
    <data noupdate="0">
        <record id="notification_template_new_ticket" model="notification.template">
            <field name="title">Công việc mới được giao</field>
            <field name="body">Bạn vừa được {{object.write_uid.name}} giao công việc {{object.name}} - "{{object.subject}}" cho khách hàng {{object.customer_id.name}} tại {{object.customer_address}}</field>
            <field name="notification_type_id"
                ref="dat_notification_management.notification_type_changes_updated" />
            <field name="target_action">open_detail_screen</field>
            <field name="screen_type">ticket_helpdesk</field>
            <field name="model_id" ref="dat_website_helpdesk.model_ticket_helpdesk" />
        </record>

        <record id="notification_template_ticket_canceled" model="notification.template">
            <field name="title">Công việc bị hủy</field>
            <field name="body">Công việc {{object.name}} - "{{object.subject}}" đã bị hủy bởi {{object.write_uid.name}}. Lý do: {{object.reject_reason}}</field>
            <field name="notification_type_id"
                ref="dat_notification_management.notification_type_changes_updated" />
            <field name="target_action">open_list_screen</field>
            <field name="screen_type">ticket_helpdesk</field>
            <field name="model_id" ref="dat_website_helpdesk.model_ticket_helpdesk" />
        </record>

        <record id="notification_template_ticket_updated" model="notification.template">
            <field name="title">Thông tin công việc được cập nhật</field>
            <field name="body">Có cập nhật mới cho công việc {{object.name}} - "{{object.subject}}". Trường thay đổi: {{changed_fields}}</field>
            <field name="notification_type_id"
                ref="dat_notification_management.notification_type_changes_updated" />
            <field name="target_action">open_detail_screen</field>
            <field name="screen_type">ticket_helpdesk</field>
            <field name="model_id" ref="dat_website_helpdesk.model_ticket_helpdesk" />
        </record>

        <record id="notification_template_ticket_reminder_overdue" model="notification.template">
            <field name="title">Công việc sắp đến hạn</field>
            <field name="body">Công việc {{object.name}} - "{{object.subject}}" sắp đến hạn hoàn thành vào {{object.deadline}}. Vui lòng cập nhật tiến độ</field>
            <field name="notification_type_id"
                ref="dat_notification_management.notification_type_reminder" />
            <field name="target_action">open_detail_screen</field>
            <field name="screen_type">ticket_helpdesk</field>
            <field name="model_id" ref="dat_website_helpdesk.model_ticket_helpdesk" />
        </record>
    </data>
</odoo>
